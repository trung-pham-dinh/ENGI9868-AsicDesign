#analyze -format sverilog ../rtl/read_fsm.sv -library top_level_lib

source dc_srcs.tcl
foreach f $RTL_SRCFILES {
    analyze -format sverilog -library top_level_lib $f
}

elaborate synchronizers -library top_level_lib
current_design synchronizers
link

#------------------------------------------------------------------------------
# Wire load
#------------------------------------------------------------------------------
set_wire_load_mode top
set_wire_load_model -name TSMC8K_Conservative

#------------------------------------------------------------------------------
# Design rule constraints
#------------------------------------------------------------------------------
set_max_transition  1.5 [find design]
set_max_capacitance 1.5 [find design]
set_max_fanout      15  [find design]
set_max_area        0

#------------------------------------------------------------------------------
# Clocks
#------------------------------------------------------------------------------
create_clock -period 8  -name wclk [find port wclk]
set_drive 0 [find port wclk]
set_dont_touch_network [find port wclk]
set_resistance 0 [find net wclk]
set_clock_uncertainty 0.350 [find clock wclk]

create_clock -period 10 -name rclk [find port rclk]
set_drive 0 [find port rclk]
set_dont_touch_network [find port rclk]
set_resistance 0 [find net rclk]
set_clock_uncertainty 0.350 [find clock rclk]

# Declare the two clocks as asynchronous (CDC handled by synchronizers)
set_clock_groups -asynchronous \
    -group [get_clocks wclk] \
    -group [get_clocks rclk]

#------------------------------------------------------------------------------
# Resets
#------------------------------------------------------------------------------
set_drive 0 [find port arstb_wclk]
set_dont_touch_network [find port arstb_wclk]
set_ideal_network -no_propagate [find net arstb_wclk]

set_drive 0 [find port arstb_rclk]
set_dont_touch_network [find port arstb_rclk]
set_ideal_network -no_propagate [find net arstb_rclk]

#------------------------------------------------------------------------------
# Input constraints
# Write-domain inputs constrained to wclk
# Read-domain inputs constrained to rclk
#------------------------------------------------------------------------------
set_input_delay -max 2 -clock wclk [get_ports {packet_written_ps}]
set_input_delay -min 0 -clock wclk [get_ports {packet_written_ps}]

set_input_delay -max 2 -clock rclk [get_ports {packet_read_ps}]
set_input_delay -min 0 -clock rclk [get_ports {packet_read_ps}]

set all_data_inputs [get_ports {packet_written_ps packet_read_ps}]
set_driving_cell -lib_cell BUFD1 $all_data_inputs

#------------------------------------------------------------------------------
# Output constraints
# Write-domain outputs constrained to wclk
# Read-domain outputs constrained to rclk
#------------------------------------------------------------------------------
set_output_delay -max 5 -clock wclk [get_ports {write_rdy_lv}]
set_output_delay -min 0 -clock wclk [get_ports {write_rdy_lv}]

set_output_delay -max 5 -clock rclk [get_ports {read_rdy_lv}]
set_output_delay -min 0 -clock rclk [get_ports {read_rdy_lv}]

set_load 2.0 [all_outputs]

#------------------------------------------------------------------------------
# Pre-compile reports
#------------------------------------------------------------------------------
report_port -verbose
report_design
report_constraint
report_clock
report_timing

#------------------------------------------------------------------------------
# Compile
#------------------------------------------------------------------------------
compile -map_effort medium

set_fix_hold [find clock wclk]
set_fix_hold [find clock rclk]
compile -map_effort high -prioritize_min_paths -only_design_rule -incremental

#------------------------------------------------------------------------------
# Post-compile reports
#------------------------------------------------------------------------------
redirect         ./synchronizers.rpt { report_area }
redirect -append ./synchronizers.rpt { report_reference }
redirect -append ./synchronizers.rpt { report_constraint -all_violators }
redirect -append ./synchronizers.rpt { report_timing -path end }
redirect -append ./synchronizers.rpt { check_design }

#------------------------------------------------------------------------------
# Write outputs
#------------------------------------------------------------------------------
write -hierarchy -format ddc     -output ./synchronizers_gate.ddc
change_names -rules verilog
write -hierarchy -format verilog -output ./synchronizers_gate.v

quit